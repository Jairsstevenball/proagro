# Copia este archivo como .env y llena los valores.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

NODE_ENV=development
PORT=4000
# Dirección con la que el CELULAR llega al servidor (se usa para las fotos).
# En casa: la IP de tu computador, ej. http://192.168.2.75:4000  (NO localhost)
# En Render: https://proagro-api.onrender.com   (en producción DEBE ser https://)
PUBLIC_URL="http://192.168.2.75:4000"

# PostgreSQL. Gratis en la nube: https://neon.tech o https://supabase.com
# Local con Docker:  docker run -d --name proagro-db -e POSTGRES_PASSWORD=proagro -p 5432:5432 postgres:16
# En producción agrega ?sslmode=require
DATABASE_URL="postgresql://postgres:proagro@localhost:5432/proagro?schema=public"

# ---- CLAVES SECRETAS ----
# Genéralas TODAS con:   npm run claves
# Si pierdes DATA_KEY o INDEX_KEY no podrás leer cédulas/celulares guardados: haz copia segura.
JWT_SECRET=""
DATA_KEY=""
INDEX_KEY=""
FILE_KEY=""
PASSWORD_PEPPER=""

# Duración de sesiones
ACCESS_TOKEN_MIN=15
REFRESH_TOKEN_DIAS=30
SESION_MAX_DIAS=90

# Detrás de un proxy (Render, Railway, Nginx) pon 1
TRUST_PROXY=0
# Solo si algún día hacen un panel web: https://admin.proagro.com.co
CORS_ORIGINS=""

# Google Gemini (gratis): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Si el principal está saturado, AgroBot prueba con estos (en orden)
GEMINI_RESPALDO="gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite"
# Preguntas por agricultor por día (protege la cuota gratuita)
AGROBOT_DIARIO=30

# Ingreso con Google y Microsoft (ver README). Varios IDs separados por coma (android,ios,web)
GOOGLE_CLIENT_IDS=""
MICROSOFT_CLIENT_ID=""

# Horario del revisor de alertas (cron, hora de Colombia). Por defecto 5:00 a.m. y 5:00 p.m.
ALERTAS_CRON="0 5,17 * * *"

UPLOAD_DIR="uploads"
TERMINOS_VERSION="2026-10"
