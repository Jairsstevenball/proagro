{
  "expo": {
    "name": "ProAgro",
    "slug": "proagro",
    "scheme": "proagro",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "co.proagro.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "ProAgro usa la cámara para tomar fotos de tus cultivos.",
        "NSPhotoLibraryUsageDescription": "ProAgro necesita tus fotos para registrar tus cultivos.",
        "NSFaceIDUsageDescription": "Usa Face ID para abrir ProAgro de forma segura.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      }
    },
    "android": {
      "package": "co.proagro.app",
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para abrir ProAgro de forma segura."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ProAgro usa la cámara para tomar fotos de tus cultivos.",
          "microphonePermission": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}