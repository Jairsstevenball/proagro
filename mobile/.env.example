# Copia como .env. Solo valores PÚBLICOS (cualquiera puede leerlos dentro de la app).

# URL del backend. En el celular NO sirve "localhost": usa la IP de tu computador en la red WiFi,
# por ejemplo http://192.168.1.50:4000/api   (en producción debe ser https://)
EXPO_PUBLIC_API_URL="http://192.168.1.50:4000/api"

# Ingreso con Google (Google Cloud Console > Credenciales > ID de cliente OAuth)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""

# Ingreso con Microsoft (portal.azure.com > Registros de aplicaciones)
EXPO_PUBLIC_MICROSOFT_CLIENT_ID=""
